<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_due_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_due_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_due_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_due_label"
        android:textColor="@color/widget_label"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_due_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_count_placeholder"
        android:textColor="@color/widget_count"
        android:textSize="34sp"
        android:textStyle="bold" />
</LinearLayout>
