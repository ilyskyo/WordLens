<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Core feature. Not "required": the deck, review and lexicon browsing all still work on
         a camera-less tablet, so we would rather install than hard-fail. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Only used by the optional bring-your-own-key vision backend. The default on-device
         engine never touches the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The voice attachment is per-entry and only ever requested at the moment the user presses
         record. Nothing is captured in the background and nothing leaves the device: the .m4a
         lives in filesDir/audio and is excluded from cloud backup by the whitelist rules. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <!-- Same reasoning as the camera: a device without a microphone loses one optional way to
         record a word, not the diary. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Android 11+ package visibility: without this TextToSpeech sees zero engines. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!--
      Android 13+ 的「按应用设置语言」只列 `localeConfig` 声明过的 locale。
      不声明的话，一个学日语的人要先把整台手机改成日语，才能把这款学日语的 App 改成日语。
      低于 33 的系统会忽略这一条（语言仍只能跟系统走），所以它只有好处、没有行为变化。
      列出的 locale 必须真的有翻译，见 res/xml/locales_config.xml 里那段。
      （注释只能待在元素外面：写在下面这个起始标签的属性之间会让 manifest 合并失败——
      XML 不允许注释插在属性中间，第一版就是这么红的。）
    -->
    <application
        android:name=".WordLensApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WordLens">

        <activity
            android:name=".MainActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.WordLens.Splash"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Look at this, what is it called?" from any gallery / browser. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- Share target so WordLens shows up in the Android share sheet directly. -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Today's due count, straight on the home screen. -->
        <receiver
            android:name=".widget.DueWidgetProvider"
            android:exported="false"
            android:label="@string/widget_due_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_due_info" />
        </receiver>
    </application>

</manifest>
